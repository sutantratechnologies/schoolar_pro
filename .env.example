# Local PostgreSQL from compose.yaml (development only)
DATABASE_URL="postgresql://devuser:devpassword@localhost:5433/saas_project?schema=public"
FRONTEND_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:4200"
# Frontend deployment target. Use main, portal, or workspace.
NEXT_PUBLIC_APP_TARGET=main
# Shared backend URL; production backend requests are accepted only from signed frontend proxies.
BACKEND_URL="http://localhost:3333"
# Generate a random secret with: openssl rand -base64 32
AUTH_PROXY_SECRET=
# In production, configure distinct backend verification secrets for each deployment.
AUTH_PROXY_SECRET_MAIN=
AUTH_PROXY_SECRET_PORTAL=
AUTH_PROXY_SECRET_WORKSPACE=
# Public auth API origin. This is not a secret.
BETTER_AUTH_URL="http://localhost:3333"
# Generate a random secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
# Must use a sender address on a domain verified in the same Resend account.
AUTH_EMAIL_FROM=
# Set only when all trusted applications are on this production parent domain.
BETTER_AUTH_COOKIE_DOMAIN=
APP_URL=
STUDENT_APP_URL=
WORKSPACE_APP_URL=
ADMIN_APP_URL=
# Optional override; the UI defaults to this local GraphQL endpoint.
# NEXT_PUBLIC_GRAPHQL_URL="http://localhost:3333/graphql"

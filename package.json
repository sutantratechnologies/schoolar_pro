  "scripts": {
    "dev:frontend": "nx dev frontend",
    "dev:student": "nx dev frontend",
    "dev:admin": "nx dev admin",
    "dev:workspace": "nx dev workspace",
    "dev:backend": "nx dev backend",
    "dev:all": "nx run-many --target=dev --projects=frontend,admin,workspace,backend --parallel",
    "dev": "nx run-many --target=dev --projects=frontend,admin,workspace,backend --parallel",
    "build:frontend": "nx build frontend",
    "build:admin": "nx build admin",
    "build:workspace": "nx build workspace",
    "build:backend": "nx build backend",
    "build:shared": "nx build shared",
    "build:all": "nx run-many --target=build --all",
    "build": "nx run-many --target=build --all",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "prisma generate --config libs/database/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config libs/database/prisma.config.ts",
    "db:push": "prisma db push --config libs/database/prisma.config.ts",
    "db:studio": "prisma studio --config libs/database/prisma.config.ts",
    "create:super-admin": "node scripts/create-super-admin.mjs",
    "lint": "nx affected --target=lint",
    "format": "nx format:write"
  },
  "private": true,
